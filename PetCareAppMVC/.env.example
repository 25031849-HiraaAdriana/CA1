# Copy this file to .env in the project root and fill in your existing MySQL settings.
# Use the same host, port, username and password as your working MySQL connection.
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_MYSQL_USERNAME
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=petcare

# Set a unique random secret of at least 32 bytes. Generate one locally with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
