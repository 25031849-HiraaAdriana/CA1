<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102A43">
  <title>Admin sign in | Pomi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/pomi-security.css" rel="stylesheet">
</head>
<body class="pomi-security-page">
  <main class="security-shell">
    <a class="security-brand" href="/"><img src="/images/pomi-logo.png" alt=""><strong>Pomi Admin</strong></a>
    <section class="security-card" aria-labelledby="admin-login-title">
      <p class="security-eyebrow">Secure workspace</p>
      <h1 id="admin-login-title">Admin sign in</h1>
      <p class="security-description">Sign in with an Admin account. A verified authenticator code is required before Admin access is granted.</p>
      <% if (errors && errors.length) { %>
        <div class="security-alert" role="alert"><% errors.forEach(error => { %><p><%= error %></p><% }); %></div>
      <% } %>
      <form class="security-form" action="/admin/login" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="security-field"><label for="username">Username</label><input id="username" name="username" autocomplete="username" required></div>
        <div class="security-field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div>
        <button class="security-button" type="submit">Continue securely</button>
      </form>
      <a class="security-inline-link" href="/login">Return to User login</a>
    </section>
  </main>
</body>
</html>
