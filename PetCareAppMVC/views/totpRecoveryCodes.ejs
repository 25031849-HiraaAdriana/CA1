<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102A43">
  <title>Save recovery codes | Pomi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/pomi-security.css" rel="stylesheet">
</head>
<body class="pomi-security-page">
  <main class="security-shell">
    <a class="security-brand" href="/"><img src="/images/pomi-logo.png" alt=""><strong>Pomi</strong></a>
    <section class="security-card" aria-labelledby="recovery-title">
      <p class="security-eyebrow">Shown once</p>
      <h1 id="recovery-title">Save your recovery codes</h1>
      <p class="security-description">Each code works once in place of an authenticator code. Store them somewhere private. Pomi stores only protected verifiers and cannot show these codes again.</p>
      <ul class="security-recovery-codes"><% recoveryCodes.forEach(code => { %><li><%= code %></li><% }); %></ul>
      <a class="security-button" href="<%= continueUrl %>"><%= admin ? 'Continue to Admin workspace' : 'Return to account security' %></a>
    </section>
  </main>
</body>
</html>
