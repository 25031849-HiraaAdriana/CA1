<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102A43">
  <title>Set up authenticator | Pomi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/pomi-security.css" rel="stylesheet">
</head>
<body class="pomi-security-page">
  <main class="security-shell">
    <a class="security-brand" href="/"><img src="/images/pomi-logo.png" alt=""><strong>Pomi</strong></a>
    <section class="security-card" aria-labelledby="setup-title">
      <p class="security-eyebrow"><%= admin ? 'Required for Admin access' : 'Optional account protection' %></p>
      <h1 id="setup-title">Set up an authenticator</h1>
      <p class="security-description">Scan this QR code with Google Authenticator or Microsoft Authenticator. If scanning is unavailable, enter the setup key manually. Codes use the standard six-digit, 30-second format.</p>
      <img class="security-qr" src="<%= qrCodeDataUrl %>" alt="Authenticator setup QR code">
      <p><strong>Manual setup key</strong></p>
      <p class="security-secret"><%= secret %></p>
      <form class="security-form" action="<%= admin ? '/admin/2fa/setup' : '/account/security/2fa/setup' %>" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="security-field"><label for="code">Current six-digit code</label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" required></div>
        <button class="security-button" type="submit">Confirm and enable 2FA</button>
      </form>
    </section>
  </main>
</body>
</html>
