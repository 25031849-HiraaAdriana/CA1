<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102A43">
  <title>Verify authenticator | Pomi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/pomi-security.css" rel="stylesheet">
</head>
<body class="pomi-security-page">
  <main class="security-shell">
    <a class="security-brand" href="/"><img src="/images/pomi-logo.png" alt=""><strong>Pomi</strong></a>
    <section class="security-card" aria-labelledby="verify-title">
      <p class="security-eyebrow"><%= admin ? 'Admin security' : 'Account security' %></p>
      <h1 id="verify-title">Verify it’s you</h1>
      <p class="security-description">Enter the current six-digit code from Google Authenticator or Microsoft Authenticator. A recovery code can be used once if you cannot access your device.</p>
      <% if (error) { %><p class="security-alert" role="alert"><%= error %></p><% } %>
      <form class="security-form" action="<%= admin ? '/admin/2fa/verify' : '/login/2fa' %>" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="security-field"><label for="code">Authenticator or recovery code</label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" autofocus required></div>
        <button class="security-button" type="submit">Verify and continue</button>
      </form>
    </section>
  </main>
</body>
</html>
