<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102A43">
  <title>Account security | Pomi</title>
  <link href="/css/pethub-dashboard.css" rel="stylesheet">
  <link href="/css/pomi-security.css" rel="stylesheet">
</head>
<body class="pethub-page dashboard-page pomi-security-page">
  <%- include('partials/navbar') %>
  <main class="security-shell">
    <section class="security-card" aria-labelledby="security-title">
      <p class="security-eyebrow">Pomi account</p>
      <h1 id="security-title">Account security</h1>
      <p class="security-description">Two-factor authentication is optional for User accounts. Admin accounts must keep it enabled.</p>
      <% if (error) { %><p class="security-alert" role="alert"><%= error %></p><% } %>
      <% if (success) { %><p class="security-alert security-alert-success" role="status"><%= success %></p><% } %>
      <% if (account.totp_enabled) { %>
        <p><strong>Status:</strong> Two-factor authentication is enabled.</p>
        <form class="security-form" action="/account/security/2fa/disable" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="security-field"><label for="password">Current password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div>
          <div class="security-field"><label for="code">Current authenticator code</label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" required></div>
          <button class="security-button" type="submit">Disable two-factor authentication</button>
        </form>
        <hr class="security-divider">
        <p>To replace your authenticator, confirm your password and current authenticator code. A new authenticator setup will replace the old one only after verification.</p>
        <form class="security-form" action="/account/security/2fa/setup/start" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="security-field"><label for="change-password">Current password</label><input id="change-password" name="password" type="password" autocomplete="current-password" required></div>
          <div class="security-field"><label for="change-code">Current authenticator code</label><input id="change-code" name="code" inputmode="numeric" autocomplete="one-time-code" required></div>
          <button class="security-button" type="submit">Change authenticator</button>
        </form>
      <% } else { %>
        <p><strong>Status:</strong> Two-factor authentication is not enabled.</p>
        <form class="security-form" action="/account/security/2fa/setup/start" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="security-field"><label for="password">Current password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div>
          <button class="security-button" type="submit">Set up an authenticator</button>
        </form>
      <% } %>
    </section>
  </main>
</body>
</html>
