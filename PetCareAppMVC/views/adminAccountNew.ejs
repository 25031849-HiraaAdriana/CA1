<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Create Admin account | Pomi</title><link href="/css/pethub-dashboard.css" rel="stylesheet"><link href="/css/pomi-security.css" rel="stylesheet"></head>
<body class="pethub-page dashboard-page pomi-security-page">
  <%- include('partials/navbar') %>
  <main class="security-shell">
    <section class="security-card" aria-labelledby="create-admin-title">
      <p class="security-eyebrow">Recent reauthentication required</p><h1 id="create-admin-title">Create an Admin account</h1>
      <p class="security-description">Confirm your password and current authenticator code for this operation. The account role is assigned server-side; this form cannot create User or other role types.</p>
      <% if (error) { %><p class="security-alert" role="alert"><%= error %></p><% } %>
      <form class="security-form" action="/admin/accounts" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="security-field"><label for="username">Admin username</label><input id="username" name="username" minlength="3" maxlength="50" autocomplete="off" required></div>
        <div class="security-field"><label for="name">Name</label><input id="name" name="name" maxlength="100" required></div>
        <div class="security-field"><label for="new-password">Temporary password (at least 12 characters)</label><input id="new-password" name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required></div>
        <div class="security-field"><label for="current-password">Your current password</label><input id="current-password" name="current_password" type="password" autocomplete="current-password" required></div>
        <div class="security-field"><label for="code">Your current authenticator code</label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" required></div>
        <button class="security-button" type="submit">Create Admin account</button>
      </form>
      <a class="security-inline-link" href="/admin/accounts">Cancel</a>
    </section>
  </main>
</body>
</html>
