<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#FFFFFF">
  <title>Welcome back | Pomi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/pomi-pages.css" rel="stylesheet">
</head>
<body class="pomi-page pomi-auth-page pomi-login-page">
  <%- include('partials/navbar') %>

  <main class="pomi-auth-layout">
    <figure class="pomi-auth-visual pomi-login-visual" data-pomi-parallax>
      <img src="/images/login-chinchillas.png" alt="Two chinchillas sitting close together" fetchpriority="high" decoding="async">
      <span class="pomi-auth-photo-wash" aria-hidden="true"></span>
      <figcaption><span>Made for everyday care</span><strong>Every pet has a story.</strong></figcaption>
      <span class="pomi-visual-orbit pomi-visual-orbit-one" aria-hidden="true"></span>
      <span class="pomi-visual-orbit pomi-visual-orbit-two" aria-hidden="true"></span>
    </figure>

    <section class="pomi-auth-column" aria-labelledby="login-title">
      <div class="pomi-auth-panel">
        <div class="pomi-auth-alerts">
          <% if (errors && errors.length > 0) { %>
            <div class="pomi-alert pomi-alert-error" role="alert">
              <% errors.forEach(function(error) { %><p><%= error %></p><% }); %>
            </div>
          <% } %>
          <% if (messages && messages.length > 0) { %>
            <div class="pomi-alert pomi-alert-success" role="status">
              <% messages.forEach(function(message) { %><p><%= message %></p><% }); %>
            </div>
          <% } %>
        </div>

        <div class="pomi-auth-content">
          <p class="pomi-eyebrow"><span aria-hidden="true"></span> Your pet care space</p>
          <h1 id="login-title">Welcome back</h1>
          <p class="pomi-auth-description">Sign in to pick up where you left off.</p>

          <form class="pomi-auth-form" action="/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="pomi-field">
              <label for="username">Username</label>
              <input type="text" class="form-control" name="username" id="username" autocomplete="username" required>
            </div>
            <div class="pomi-field">
              <label for="password">Password</label>
              <input type="password" class="form-control" name="password" id="password" autocomplete="current-password" required>
            </div>
            <button type="submit" class="pomi-button pomi-button-primary pomi-submit-button">Login <span aria-hidden="true">→</span></button>
          </form>

          <p class="pomi-auth-switch">New to Pomi? <a href="/signup">Create an account</a></p>
        </div>
        <p class="pomi-auth-footnote">A thoughtful place for the details of their care.</p>
      </div>
    </section>
  </main>
  <script src="/js/pomi-pages.js" defer></script>
</body>
</html>
