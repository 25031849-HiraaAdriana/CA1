<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Medication Refill Demonstration | Pomi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin-medical-records.css" rel="stylesheet">
</head>
<body class="medical-records-page">
  <%- include('partials/navbar') %>
  <main class="container medical-records-shell">
    <a class="medical-back-link" href="/admin/dashboard">← Admin Dashboard</a>
    <header class="medical-page-header">
      <p class="medical-eyebrow">Admin workspace · CA1 school demonstration</p>
      <h1>Medication Refill Requests</h1>
      <p>Administrative demo review only. No veterinary authorisation, prescription, supply or payment is provided.</p>
    </header>

    <% if (successMessage) { %><div class="alert alert-success" role="status"><%= successMessage %></div><% } %>
    <% if (errorMessage) { %><div class="alert alert-danger" role="alert"><%= errorMessage %></div><% } %>

    <% if (!featureReady) { %>
      <section class="medical-panel">
        <h2>Feature awaits database approval</h2>
        <p>Review the proposed additive migration at <code>migrations/006_medication_refill_demo.sql</code>. No migration has been run.</p>
      </section>
    <% } else if (requests.length) { %>
      <div class="medical-panel-list">
        <% requests.forEach(request => { %>
          <article class="medical-panel refill-admin-card">
            <header class="medical-panel-heading">
              <div>
                <p class="medical-eyebrow">Request #<%= request.id %> · <%= request.status === 'Ready for Test Payment' ? 'Accepted with Demo Quotation' : request.status %></p>
                <h2><%= request.medication_name %></h2>
              </div>
              <% if (request.displayPrice) { %><span class="status-badge"><%= request.displayPrice %> demo quotation</span><% } %>
            </header>
            <dl class="medical-record-details">
              <div><dt>Pet</dt><dd><%= request.pet_name %> (ID <%= request.pet_id %>)</dd></div>
              <div><dt>Pet status</dt><dd><%= request.pet_status === 'deceased' ? 'Deceased · history only' : 'Active' %></dd></div>
              <div><dt>Owner</dt><dd><%= request.owner_name %> (ID <%= request.owner_id %>)</dd></div>
              <div><dt>Linked medical record</dt><dd><%= request.record_title %> (ID <%= request.medical_record_id %>)</dd></div>
              <% if (request.dosage) { %><div><dt>Documented dosage</dt><dd><%= request.dosage %></dd></div><% } %>
              <% if (request.frequency) { %><div><dt>Documented frequency</dt><dd><%= request.frequency %></dd></div><% } %>
              <div><dt>Reason</dt><dd><%= request.refill_reason || 'Not recorded' %></dd></div>
              <div><dt>Requested quantity and unit</dt><dd><%= request.requested_quantity != null && request.requested_quantity_unit ? request.requested_quantity + ' ' + request.requested_quantity_unit : 'Not recorded' %></dd></div>
              <div><dt>User message</dt><dd><%= request.message || 'None' %></dd></div>
              <% if (request.admin_review_note) { %><div><dt>Prior demo review</dt><dd><%= request.admin_review_note %></dd></div><% } %>
              <div><dt>Submitted</dt><dd><%= request.created_at %></dd></div>
            </dl>
            <p class="medical-note">This administrative review is not veterinary authorisation. Payment is Coming in CA2; do not collect payment.</p>

            <% if (request.pet_status === 'deceased') { %>
              <p class="payment-coming-soon">This pet is inactive in Pomi. The refill request is retained as history and cannot receive a new review or demo quotation.</p>
            <% } else if (request.status === 'Pending' || request.status === 'More Information Required') { %>
              <form class="refill-review-form" method="post" action="/admin/refill-requests/<%= encodeURIComponent(request.id) %>/review">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="row g-3">
                  <div class="col-12 col-md-4">
                    <label class="form-label" for="status-<%= request.id %>">Administrative demo status</label>
                    <select class="form-select" id="status-<%= request.id %>" name="status" required>
                      <option value="Rejected">Rejected</option>
                      <option value="Ready for Test Payment">Accepted with Demo Quotation</option>
                    </select>
                  </div>
                  <div class="col-12 col-md-4">
                    <label class="form-label" for="price-<%= request.id %>">Demo quotation (SGD, required when accepted)</label>
                    <input class="form-control" id="price-<%= request.id %>" name="demo_price"
                      type="number" min="0.01" max="100000" step="0.01">
                  </div>
                  <div class="col-12">
                    <label class="form-label" for="note-<%= request.id %>">Administrative demo review note</label>
                    <textarea class="form-control" id="note-<%= request.id %>" name="admin_review_note"
                      maxlength="500" rows="2"></textarea>
                  </div>
                  <div class="col-12"><button class="btn medical-primary-button" type="submit">Save Administrative Demo Review</button></div>
                </div>
              </form>
            <% } else if (request.status === 'Ready for Test Payment') { %>
              <p class="payment-coming-soon">Payment is Coming in CA2. No Pay button or transaction is available in CA1.</p>
            <% } else if (request.status === 'Paid') { %>
              <p class="payment-coming-soon">Paid is reserved for CA2; CA1 does not process payments.</p>
            <% } %>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <section class="medical-empty-state"><h2>No refill requests have been submitted.</h2></section>
    <% } %>
  </main>
</body>
</html>
