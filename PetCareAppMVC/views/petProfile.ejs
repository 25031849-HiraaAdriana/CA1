<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102A43">
  <title><%= pet.name %> | Pomi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/pethub-registration.css" rel="stylesheet">
</head>
<body class="pethub-page">
  <%- include('partials/navbar') %>
  <main class="pethub-content">
    <a class="profile-back-link" href="/pets/new">Register another pet</a>
    <article class="profile-card">
      <% if (pet.image) { %>
        <img class="profile-photo" src="/images/<%= pet.image %>" alt="Photo of <%= pet.name %>">
      <% } else { %>
        <div class="profile-photo profile-photo-placeholder" aria-hidden="true">
          <%- include('partials/progressPaw') %>
        </div>
      <% } %>
      <div class="profile-details">
        <p class="eyebrow">Pet profile</p>
        <h1><%= pet.name %></h1>
        <dl>
          <div><dt>Species</dt><dd><%= pet.species %></dd></div>
          <div><dt>Breed</dt><dd><%= pet.breed %></dd></div>
          <div><dt>Age</dt><dd><%= pet.age %> years</dd></div>
        </dl>
      </div>
    </article>
    <a class="button button-primary" href="/pets/<%= encodeURIComponent(pet.id) %>/medical-records">
      View Health Passport &amp; Medical Records
    </a>
  </main>
</body>
</html>
