<% if (typeof session !== 'undefined' && session.user && session.user.role === 'admin') { %>
  <% const adminCurrentPath = typeof currentPath === 'string' ? currentPath : ''; %>
  <% const navCsrfToken = typeof csrfToken === 'string' ? csrfToken : ''; %>
  <script>document.body.classList.add('pomi-admin');</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/pet-shop.css" rel="stylesheet">
  <link href="/css/pethub-design-system.css" rel="stylesheet">
  <link href="/css/pomi-admin.css" rel="stylesheet">
  <aside class="pomi-admin-sidebar" id="pomiAdminSidebar" aria-label="Admin sidebar">
    <a class="pomi-admin-brand" href="/admin/dashboard" aria-label="Pomi Admin Dashboard">
      <span class="pomi-admin-brand-mark"><img src="/images/pomi-logo.png" alt=""></span>
      <span class="pomi-admin-brand-copy"><strong>Pomi</strong><small>ADMIN WORKSPACE</small></span>
    </a>
    <button class="pomi-admin-close" type="button" data-admin-close aria-label="Close admin navigation">×</button>

    <button class="pomi-admin-collapse" type="button" data-admin-collapse aria-expanded="true" aria-label="Collapse sidebar">
      <span aria-hidden="true">‹</span><span class="pomi-admin-collapse-label">Collapse sidebar</span>
    </button>

    <nav class="pomi-admin-nav" aria-label="Admin navigation">
      <p class="pomi-admin-nav-label">Overview</p>
      <a class="pomi-admin-link<%= adminCurrentPath === '/admin/dashboard' ? ' is-active' : '' %>" href="/admin/dashboard" aria-label="Dashboard" title="Dashboard" <%- adminCurrentPath === '/admin/dashboard' ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="5" rx="2"/><rect x="13" y="10" width="8" height="11" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/></svg><span>Dashboard</span>
      </a>
      <p class="pomi-admin-nav-label">Management</p>
      <a class="pomi-admin-link<%= adminCurrentPath.startsWith('/admin/users') ? ' is-active' : '' %>" href="/admin/users" aria-label="Users and pets" title="Users and pets" <%- adminCurrentPath.startsWith('/admin/users') ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.8 20v-1.6a5.2 5.2 0 0 1 5.2-5.2h2a5.2 5.2 0 0 1 5.2 5.2V20M16 5.2a3.5 3.5 0 0 1 0 6.7M18 13.7a4.5 4.5 0 0 1 3.2 4.3v2"/></svg><span>Users &amp; pets</span>
      </a>
      <p class="pomi-admin-nav-label">Healthcare</p>
      <a class="pomi-admin-link<%= adminCurrentPath.startsWith('/admin/medical-records') ? ' is-active' : '' %>" href="/admin/medical-records" aria-label="Medical records" title="Medical records" <%- adminCurrentPath.startsWith('/admin/medical-records') ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M14 3v5h5M8.5 13h7M8.5 16.5h7M12 9.5v7"/></svg><span>Medical records</span>
      </a>
      <a class="pomi-admin-link<%= adminCurrentPath.startsWith('/admin/refill-requests') ? ' is-active' : '' %>" href="/admin/refill-requests" aria-label="Medication refills" title="Medication refills" <%- adminCurrentPath.startsWith('/admin/refill-requests') ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 3H7a4 4 0 0 0 0 8h10a4 4 0 0 1 0 8h-3M14 3h3a4 4 0 0 1 0 8H7a4 4 0 0 0 0 8h3M12 2v20"/></svg><span>Medication refills</span>
      </a>
      <a class="pomi-admin-link<%= adminCurrentPath.startsWith('/admin/appointments') ? ' is-active' : '' %>" href="/admin/appointments" aria-label="Appointments" title="Appointments" <%- adminCurrentPath.startsWith('/admin/appointments') ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M8 14h3M8 17h6"/></svg><span>Appointments</span>
      </a>
      <p class="pomi-admin-nav-label">Commerce</p>
      <a class="pomi-admin-link<%= adminCurrentPath.startsWith('/admin/products') ? ' is-active' : '' %>" href="/admin/products" aria-label="Products" title="Products" <%- adminCurrentPath.startsWith('/admin/products') ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 2-5h14l2 5M4 8v12h16V8M3 8h18M9 12v4h6v-4"/></svg><span>Products</span>
      </a>
      <p class="pomi-admin-nav-label">Administration</p>
      <a class="pomi-admin-link<%= adminCurrentPath.startsWith('/admin/activity-history') ? ' is-active' : '' %>" href="/admin/activity-history" aria-label="Activity history" title="Activity history" <%- adminCurrentPath.startsWith('/admin/activity-history') ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5M4 19h17M8 15l3-4 3 2 5-7"/><circle cx="8" cy="15" r="1"/><circle cx="11" cy="11" r="1"/><circle cx="14" cy="13" r="1"/><circle cx="19" cy="6" r="1"/></svg><span>Activity history</span>
      </a>
    </nav>

    <div class="pomi-admin-account">
      <span class="pomi-admin-avatar" aria-hidden="true"><%= (session.user.name || 'A').charAt(0).toUpperCase() %></span>
      <span class="pomi-admin-account-copy"><strong><%= session.user.name %></strong><small>Administrator</small></span>
      <form class="pomi-admin-logout-form" method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= navCsrfToken %>">
        <button class="pomi-admin-logout" type="submit" aria-label="Sign out">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H5v14h5M14 16l4-4-4-4M18 12H9"/></svg><span class="pomi-admin-logout-label">Sign out</span>
        </button>
      </form>
    </div>
  </aside>
  <div class="pomi-admin-mobile-header">
    <a class="pomi-admin-mobile-brand" href="/admin/dashboard" aria-label="Pomi Admin Dashboard"><img src="/images/pomi-logo.png" alt=""><strong>Pomi Admin</strong></a>
    <button class="pomi-admin-menu-button" type="button" data-admin-open aria-expanded="false" aria-controls="pomiAdminSidebar" aria-label="Open admin navigation"><span></span><span></span><span></span></button>
  </div>
  <button class="pomi-admin-overlay" type="button" data-admin-overlay aria-label="Close admin navigation"></button>
  <script src="/js/pomi-admin.js" defer></script>
<% } else { %>
  <% const navCsrfToken = typeof csrfToken === 'string' ? csrfToken : ''; %>
  <link href="/css/pethub-registration.css" rel="stylesheet">
  <link href="/css/pet-shop.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/pethub-design-system.css" rel="stylesheet">
  <link href="/css/pomi-pages.css" rel="stylesheet">
  <nav class="portal-navbar" aria-label="Main navigation">
    <div class="portal-navbar-inner">
      <% const homeUrl = session && session.user ? '/dashboard' : '/'; %>
      <a class="portal-brand" href="<%= homeUrl %>" aria-label="Pomi home">
        <span class="portal-brand-mark" aria-hidden="true">
          <img src="/images/pomi-logo.png" alt="">
        </span>
        <span class="portal-brand-copy">
          <strong>Pomi</strong>
          <span>A companion for pet care</span>
        </span>
      </a>

      <button class="portal-nav-toggle" type="button" data-pethub-nav-toggle aria-expanded="false" aria-controls="portalNavigation">
        <span class="visually-hidden">Toggle navigation</span>
        <span></span><span></span><span></span>
      </button>

      <div class="portal-navigation" id="portalNavigation" data-pethub-nav-menu>
        <ul>
        <% if (!(session && session.user) && (typeof currentPath === 'undefined' || (currentPath !== '/login' && currentPath !== '/signup'))) { %>
          <li><a href="/shop" <% if (typeof currentPath !== 'undefined' && currentPath.startsWith('/shop')) { %>class="is-active" aria-current="page"<% } %>>Pet Shop</a></li>
        <% } %>
        <% if (session && session.user) { %>
          <% if (session.user.role === 'admin') { %>
            <li><a href="/admin/dashboard" <% if (typeof currentPath !== 'undefined' && currentPath === '/admin/dashboard') { %>class="is-active" aria-current="page"<% } %>>Dashboard</a></li>
            <li><a href="/admin/products" <% if (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/products')) { %>class="is-active" aria-current="page"<% } %>>Products</a></li>
            <li><a href="/admin/activity-history" <% if (typeof currentPath !== 'undefined' && currentPath === '/admin/activity-history') { %>class="is-active" aria-current="page"<% } %>>Activity history</a></li>
            <li><a href="/admin/refill-requests" <% if (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/refill-requests')) { %>class="is-active" aria-current="page"<% } %>>Refill requests</a></li>
            <li><a href="/admin/appointments" <% if (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/appointments')) { %>class="is-active" aria-current="page"<% } %>>Appointments</a></li>
            <li><a href="/admin/users" <% if (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/users')) { %>class="is-active" aria-current="page"<% } %>>Manage users</a></li>
          <% } else { %>
            <li><a href="/dashboard" <% if (typeof currentPath !== 'undefined' && currentPath === '/dashboard') { %>class="is-active" aria-current="page"<% } %>>Dashboard</a></li>
            <li><a href="/dashboard#digital-health-passport">My Pets</a></li>
            <li><a href="/pets/new" <% if (typeof currentPath !== 'undefined' && currentPath === '/pets/new') { %>class="is-active" aria-current="page"<% } %>>Register a Pet</a></li>
            <li><a href="/shop" <% if (typeof currentPath !== 'undefined' && currentPath.startsWith('/shop')) { %>class="is-active" aria-current="page"<% } %>>Pomi Store</a></li>
          <% } %>
          <li class="account-menu">
            <details>
              <summary>
                <span class="account-avatar" aria-hidden="true"><%= (session.user.name || 'U').charAt(0).toUpperCase() %></span>
                <span class="account-name"><%= session.user.name %></span>
                <svg class="account-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5"/></svg>
              </summary>
              <div class="account-dropdown">
                <span class="account-dropdown-label">Signed in as</span>
                <strong><%= session.user.name %></strong>
                <span class="account-role"><%= session.user.role === 'admin' ? 'Administrator' : 'Pet owner' %></span>
                <form method="post" action="/logout">
                  <input type="hidden" name="_csrf" value="<%= navCsrfToken %>">
                  <button class="account-logout" type="submit">Sign out</button>
                </form>
              </div>
            </details>
          </li>
        <% } else { %>
          <li><a href="/login" <% if (typeof currentPath !== 'undefined' && currentPath === '/login') { %>class="is-active" aria-current="page"<% } %>>Log in</a></li>
          <li><a class="nav-signup<% if (typeof currentPath !== 'undefined' && currentPath === '/signup') { %> is-active<% } %>" href="/signup" <% if (typeof currentPath !== 'undefined' && currentPath === '/signup') { %>aria-current="page"<% } %>>Create an account</a></li>
        <% } %>
        </ul>
      </div>
      <% if (session && session.user) { %>
        <a class="portal-cart<% if (typeof currentPath !== 'undefined' && currentPath === '/cart') { %> is-active<% } %>" href="/cart" aria-label="Shopping Cart<% if (typeof cartCountUnavailable !== 'undefined' && cartCountUnavailable) { %> (item count unavailable)<% } else if (typeof cartCount !== 'undefined' && cartCount > 0) { %> (<%= cartCount %> <%= cartCount === 1 ? 'item' : 'items' %>)<% } %>" <% if (typeof cartCountUnavailable !== 'undefined' && cartCountUnavailable) { %>title="Cart item count unavailable"<% } %> <% if (typeof currentPath !== 'undefined' && currentPath === '/cart') { %>aria-current="page"<% } %>>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h8.5a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
          <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %><span class="shop-cart-count" aria-hidden="true"><%= cartCount %></span><% } %>
        </a>
      <% } %>
    </div>
  </nav>
  <script src="/js/pethub-navigation.js" defer></script>
<% } %>
