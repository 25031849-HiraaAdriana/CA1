<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#FFFFFF">
  <title>Create an account | Pomi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/pomi-pages.css" rel="stylesheet">
</head>
<body class="pomi-page pomi-auth-page pomi-signup-page">
  <%- include('partials/navbar') %>

  <main class="pomi-auth-layout">
    <section class="pomi-auth-column" aria-labelledby="signup-title">
      <div class="pomi-auth-panel">
        <div class="pomi-auth-alerts">
          <% if (errors && errors.length > 0) { %>
            <div class="pomi-alert pomi-alert-error" role="alert">
              <% errors.forEach(function(error) { %><p><%= error %></p><% }); %>
            </div>
          <% } %>
          <% if (messages && messages.length > 0) { %>
            <div class="pomi-alert pomi-alert-success" role="status">
              <% messages.forEach(function(message) { %><p><%= message %></p><% }); %>
            </div>
          <% } %>
        </div>

        <div class="pomi-auth-content">
          <p class="pomi-eyebrow"><span aria-hidden="true"></span> Start with the essentials</p>
          <h1 id="signup-title">Create your account</h1>
          <p class="pomi-auth-description">A welcoming home for the important details of your pet's care.</p>

          <form class="pomi-auth-form" action="/signup" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="pomi-field">
              <label for="username">Username</label>
              <input type="text" class="form-control" name="username" id="username" autocomplete="username" required>
            </div>
            <div class="pomi-field">
              <label for="password">Password</label>
              <input type="password" class="form-control" name="password" id="password" autocomplete="new-password" required>
            </div>
            <div class="pomi-field">
              <label for="name">Your name</label>
              <input type="text" class="form-control" name="name" id="name" autocomplete="name" required>
            </div>
            <button type="submit" class="pomi-button pomi-button-primary pomi-submit-button">Create Account <span aria-hidden="true">→</span></button>
          </form>

          <p class="pomi-auth-switch">Already have an account? <a href="/login">Login</a></p>
        </div>
        <p class="pomi-auth-footnote">Made for you and the pets you love.</p>
      </div>
    </section>

    <figure class="pomi-auth-visual pomi-signup-visual" data-pomi-parallax>
      <img src="/images/ella.jpg" alt="A cat resting comfortably at home" fetchpriority="high" decoding="async">
      <span class="pomi-auth-photo-wash" aria-hidden="true"></span>
      <figcaption><span>A little closer to their world</span><strong>Care starts with knowing them.</strong></figcaption>
      <span class="pomi-visual-orbit pomi-visual-orbit-one" aria-hidden="true"></span>
      <span class="pomi-visual-orbit pomi-visual-orbit-two" aria-hidden="true"></span>
    </figure>
  </main>
  <script src="/js/pomi-pages.js" defer></script>
</body>
</html>
