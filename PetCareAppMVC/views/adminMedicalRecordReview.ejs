<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Review Medical Record | Pomi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin-medical-records.css" rel="stylesheet">
</head>
<body class="medical-records-page">
  <%- include('partials/navbar') %>

  <main class="container medical-records-shell medical-review-shell">
    <a class="medical-back-link" href="/admin/medical-records">← Medical Records Management</a>
    <header class="medical-page-header">
      <p class="medical-eyebrow">Admin workspace · Draft review</p>
      <h1>Review medical record</h1>
      <p>Compare the private original document with extracted text, correct details, and publish only after review.</p>
    </header>

    <% if (successMessage) { %>
      <div class="alert alert-success" role="status"><%= successMessage %></div>
    <% } %>
    <% if (errorMessage) { %>
      <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
    <% } %>
    <% if (record.onePageRecovery) { %>
      <div class="alert alert-warning" role="alert">This record was already saved privately. Do not upload it again. Resolve the issue here, or contact an administrator if publication may have completed.</div>
    <% } %>

    <section class="medical-panel" aria-labelledby="record-details-title">
      <div class="medical-panel-heading">
        <h2 id="record-details-title">Record and pet details</h2>
        <span class="status-badge"><%= record.publication_status %></span>
      </div>
      <dl class="medical-record-details">
        <div><dt>Record ID</dt><dd><%= record.id %></dd></div>
        <div><dt>Registered pet</dt><dd><%= record.pet_name %></dd></div>
        <div><dt>Microchip ID</dt><dd><%= record.microchip_id || 'Not on file' %></dd></div>
        <div><dt>AVS licence number</dt><dd><%= record.avs_licence_number || 'Not on file' %></dd></div>
        <div><dt>Extraction status</dt><dd><%= record.extraction_status.replace(/_/g, ' ') %></dd></div>
        <div><dt>Uploaded</dt><dd><%= record.uploaded_at %></dd></div>
        <div><dt>Uploaded by Admin</dt><dd><%= record.uploaded_by_admin_name %> (ID <%= record.uploaded_by_admin_id %>)</dd></div>
        <div><dt>Original filename</dt><dd><%= record.original_filename %></dd></div>
      </dl>
    </section>

    <section class="medical-panel" aria-labelledby="original-document-title">
      <div class="medical-panel-heading">
        <h2 id="original-document-title">Unchanged original document</h2>
        <a class="btn btn-sm medical-secondary-button"
          href="/admin/medical-records/<%= encodeURIComponent(record.id) %>/document/download">
          Download original
        </a>
      </div>
      <iframe class="medical-document-preview"
        src="/admin/medical-records/<%= encodeURIComponent(record.id) %>/document/preview"
        title="Original medical document: <%= record.original_filename %>">
      </iframe>
      <p class="medical-note">
        If the document is not displayed by your browser,
        <a href="/admin/medical-records/<%= encodeURIComponent(record.id) %>/document/preview" target="_blank" rel="noopener">
          open the original document
        </a>.
      </p>
    </section>

    <section class="medical-panel" aria-labelledby="review-form-title">
      <div class="medical-panel-heading">
        <h2 id="review-form-title">Confirm and correct record</h2>
      </div>
      <form method="post" action="/admin/medical-records/<%= encodeURIComponent(record.id) %>/review">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="review_version" value="<%= record.reviewVersion || '' %>">
        <fieldset class="medical-fieldset">
          <legend>Medical record information</legend>
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label class="form-label" for="category-code">Category <span aria-hidden="true">*</span></label>
              <select class="form-select" id="category-code" name="category_code" data-medication-category required>
                <option value="">Choose a category</option>
                <% categories.forEach(category => { %>
                  <option value="<%= category.category_code %>"
                    <%= formData.categoryCode === category.category_code ? 'selected' : '' %>>
                    <%= category.category_name %>
                  </option>
                <% }); %>
              </select>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label" for="record-date">Record or consultation date</label>
              <input class="form-control" id="record-date" name="record_date" type="date"
                value="<%= formData.recordDate %>">
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label" for="record-title">Record title <span aria-hidden="true">*</span></label>
              <input class="form-control" id="record-title" name="title" type="text" maxlength="200"
                value="<%= formData.title %>" required>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label" for="source-name">Veterinary clinic or source name <span aria-hidden="true">*</span></label>
              <input class="form-control" id="source-name" name="source_name" type="text" maxlength="200"
                value="<%= formData.sourceName %>" required>
            </div>
            <div class="col-12">
              <label class="form-label" for="record-description">Description <span class="optional-label">(optional)</span></label>
              <textarea class="form-control" id="record-description" name="description" rows="3"
                maxlength="60000"><%= formData.description %></textarea>
            </div>
          </div>
        </fieldset>

        <fieldset class="medical-fieldset medication-structure-fieldset"
          data-medication-section
          <%= formData.categoryCode === 'medication_history' ? '' : 'hidden' %>>
          <legend>Structured Medication History · school demonstration</legend>
          <p class="medical-note">
            Enter only medication details directly documented in the original source after Admin review. Do not copy or infer medication facts from OCR text alone. These entries are not veterinary authorisation.
          </p>
          <% if (!medicationFeatureReady) { %>
            <p class="alert alert-warning">Structured medication entries require approval and application of the proposed migrations/006_medication_refill_demo.sql.</p>
          <% } %>
          <div class="medication-entry-rows" data-medication-entry-rows>
            <% const medicationRows = formData.medications.length ? formData.medications : [{ medicationName: '', dosage: '', frequency: '', startDate: '', endDate: '' }]; %>
            <% medicationRows.forEach((medication, index) => { %>
              <fieldset class="medication-entry-row" data-medication-entry-row>
                <legend class="visually-hidden">Medication entry</legend>
                <div class="row g-3">
                  <div class="col-12 col-md-4">
                    <label class="form-label" for="medication_name-<%= index %>">Medication name</label>
                    <input class="form-control" id="medication_name-<%= index %>" name="medication_name[]" type="text" maxlength="200"
                      value="<%= medication.medicationName %>">
                  </div>
                  <div class="col-12 col-md-4">
                    <label class="form-label" for="medication_dosage-<%= index %>">Documented dosage</label>
                    <input class="form-control" id="medication_dosage-<%= index %>" name="medication_dosage[]" type="text" maxlength="120"
                      value="<%= medication.dosage %>">
                  </div>
                  <div class="col-12 col-md-4">
                    <label class="form-label" for="medication_frequency-<%= index %>">Documented frequency</label>
                    <input class="form-control" id="medication_frequency-<%= index %>" name="medication_frequency[]" type="text" maxlength="120"
                      value="<%= medication.frequency %>">
                  </div>
                  <div class="col-12 col-md-6">
                    <label class="form-label" for="medication_start_date-<%= index %>">Start date</label>
                    <input class="form-control" id="medication_start_date-<%= index %>" name="medication_start_date[]" type="date"
                      value="<%= medication.startDate %>">
                  </div>
                  <div class="col-12 col-md-6">
                    <label class="form-label" for="medication_end_date-<%= index %>">End date</label>
                    <input class="form-control" id="medication_end_date-<%= index %>" name="medication_end_date[]" type="date"
                      value="<%= medication.endDate %>">
                  </div>
                  <div class="col-12"><button class="btn medical-cancel-button" type="button" data-remove-medication>Remove entry</button></div>
                </div>
              </fieldset>
            <% }); %>
          </div>
          <button class="btn medical-secondary-button" type="button" data-add-medication>Add medication entry</button>
          <template data-medication-entry-template>
            <fieldset class="medication-entry-row">
              <legend class="visually-hidden">Medication entry</legend>
              <div class="row g-3">
                <div class="col-12 col-md-4">
                  <label class="form-label" for="medication_name-new">Medication name</label>
                  <input class="form-control" id="medication_name-new" name="medication_name[]" type="text" maxlength="200">
                </div>
                <div class="col-12 col-md-4">
                  <label class="form-label" for="medication_dosage-new">Documented dosage</label>
                  <input class="form-control" id="medication_dosage-new" name="medication_dosage[]" type="text" maxlength="120">
                </div>
                <div class="col-12 col-md-4">
                  <label class="form-label" for="medication_frequency-new">Documented frequency</label>
                  <input class="form-control" id="medication_frequency-new" name="medication_frequency[]" type="text" maxlength="120">
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label" for="medication_start_date-new">Start date</label>
                  <input class="form-control" id="medication_start_date-new" name="medication_start_date[]" type="date">
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label" for="medication_end_date-new">End date</label>
                  <input class="form-control" id="medication_end_date-new" name="medication_end_date[]" type="date">
                </div>
                <div class="col-12"><button class="btn medical-cancel-button" type="button" data-remove-medication>Remove entry</button></div>
              </div>
            </fieldset>
          </template>
        </fieldset>

        <% if (record.extraction_status !== 'not_extracted') { %>
        <fieldset class="medical-fieldset">
          <legend>Extracted document text</legend>
          <label class="form-label" for="extracted-document-text">Review and correct the text extracted from the original</label>
          <textarea class="form-control medical-extracted-text" id="extracted-document-text"
            name="extracted_document_text" rows="14"><%= formData.extractedText %></textarea>
          <% if (record.document_mime_type === 'image/jpeg' || record.document_mime_type === 'image/png') { %>
            <div class="form-check mt-3">
              <input class="form-check-input" id="image-only-reviewed" name="image_only_reviewed"
                type="checkbox" value="yes" <%= formData.imageOnlyReviewed ? 'checked' : '' %>>
              <label class="form-check-label" for="image-only-reviewed">
                I reviewed this image-only Radiology Results record; it contains no document text to publish.
              </label>
            </div>
            <p class="medical-note mt-2">This confirmation is valid only when the category is Radiology Results (X-ray, CT, MRI) and the extracted-text field is empty.</p>
          <% } %>
        </fieldset>
        <% } %>

        <fieldset class="medical-fieldset">
          <legend>Handwritten signature approval</legend>
          <p class="medical-note">Draw your signature below to confirm that you reviewed the original document before publication. This signature is tied to your admin account and the reviewed record version.</p>
          <div class="signature-panel" aria-label="Signature pad">
            <canvas id="signaturePad" class="signature-canvas" width="900" height="260" aria-label="Draw your signature"></canvas>
          </div>
          <div class="signature-toolbar">
            <button class="btn medical-secondary-button" type="button" data-signature-clear>Clear Signature</button>
            <span class="signature-status" data-signature-status>Waiting for signature…</span>
          </div>
          <input id="signature-data-url" type="hidden" name="signature_data_url" value="">
        </fieldset>

        <div class="medical-form-notice" role="note">
          <% if (record.extraction_status === 'not_extracted') { %>
            The original file is never changed. Review confirmation and a valid handwritten signature are required to publish.
          <% } else { %>
            Save Draft records the corrections and review without publishing. Publishing requires non-empty reviewed text, or the image-only X-ray exception described above, together with a valid handwritten signature and review confirmation. The original file is never changed.
          <% } %>
        </div>
        <div class="medical-form-actions">
          <a class="btn medical-cancel-button" href="/admin/medical-records">Back to Drafts</a>
          <button class="btn medical-secondary-button" type="submit" name="action" value="save_draft">
            Save Draft
          </button>
          <button class="btn medical-primary-button" type="submit" name="action" value="publish">
            Sign &amp; Publish record
          </button>
        </div>
        <div class="form-check mt-3">
          <input class="form-check-input" id="confirm-publish" name="confirm_publish"
            type="checkbox" value="yes" <%= formData.confirmPublish ? 'checked' : '' %>>
          <label class="form-check-label" for="confirm-publish">
            I confirm that I reviewed the original document and record details before publishing.
          </label>
        </div>
      </form>
    </section>
  </main>
  <script src="/js/signature-pad.js" defer></script>
  <script src="/js/medical-medication-entries.js" defer></script>
</body>
</html>
