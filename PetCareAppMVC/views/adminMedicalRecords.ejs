<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Add Medical Record | Pomi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin-medical-records.css" rel="stylesheet">
</head>
<body class="medical-records-page">
  <%- include('partials/navbar') %>
  <main class="container medical-records-shell">
    <a class="medical-back-link" href="/admin/dashboard">← Admin Dashboard</a>
    <header class="medical-page-header">
      <p class="medical-eyebrow">Admin workspace</p>
      <h1>Add Medical Record</h1>
      <p>Select a registered pet, review the original document and sign before publishing.</p>
    </header>
    <% if (successMessage) { %><div class="alert alert-success" role="status"><%= successMessage %></div><% } %>
    <% if (errorMessage) { %><div class="alert alert-danger" role="alert"><%= errorMessage %></div><% } %>

    <section class="medical-panel">
      <h2>Find a registered pet</h2>
      <form class="row g-2 align-items-end" method="get" action="/admin/medical-records">
        <div class="col-12 col-md-9">
          <label class="form-label" for="pet-search">Pet name, Microchip ID or AVS licence number</label>
          <input class="form-control" id="pet-search" name="q" type="search" value="<%= searchTerm %>" maxlength="100">
        </div>
        <div class="col-12 col-md-3"><button class="btn medical-secondary-button" type="submit">Search pets</button></div>
      </form>
      <% if (pets.length === 100) { %><p class="medical-note">Showing the first 100 matches. Narrow your search if needed.</p><% } %>
    </section>

    <section class="medical-panel">
      <form method="post" action="/admin/medical-records/publish" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <fieldset class="medical-fieldset">
          <legend>Pet and record details</legend>
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label class="form-label" for="record-pet">Registered pet</label>
              <select class="form-select" id="record-pet" name="pet_id" required>
                <option value="">Select a pet from the search results</option>
                <% pets.forEach(pet => { %>
                  <option value="<%= pet.id %>" <%= String(selectedPetId || '') === String(pet.id) ? 'selected' : '' %>><%= pet.name %> · <%= pet.owner_name || 'Registered pet' %> · ID <%= pet.id %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label" for="category-code">Category</label>
              <select class="form-select" id="category-code" name="category_code" data-medication-category required>
                <option value="">Choose a category</option>
                <% categories.forEach(category => { %><option value="<%= category.category_code %>" <%= formData.categoryCode === category.category_code ? 'selected' : '' %>><%= category.category_name %></option><% }); %>
              </select>
            </div>
            <div class="col-12 col-md-6"><label class="form-label" for="record-title">Title</label><input class="form-control" id="record-title" name="title" maxlength="200" value="<%= formData.title %>" required></div>
            <div class="col-12 col-md-6"><label class="form-label" for="source-name">Clinic or source</label><input class="form-control" id="source-name" name="source_name" maxlength="200" value="<%= formData.sourceName %>" required></div>
            <div class="col-12 col-md-6"><label class="form-label" for="record-date">Record date</label><input class="form-control" id="record-date" name="record_date" type="date" value="<%= formData.recordDate %>"></div>
            <div class="col-12"><label class="form-label" for="description">Description</label><textarea class="form-control" id="description" name="description" rows="3" maxlength="60000"><%= formData.description %></textarea></div>
          </div>
        </fieldset>
        <fieldset class="medical-fieldset">
          <legend>Original medical document</legend>
          <label class="form-label" for="medical-document">One PDF, JPEG or PNG (maximum 10 MB)</label>
          <input class="form-control" id="medical-document" name="medical_document" type="file" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" required>
          <p class="medical-note">Review the selected original before publishing. It is stored privately.</p>
          <div class="medical-local-preview" data-original-preview hidden>
            <img class="medical-preview-image" data-preview-image alt="Selected original document" hidden>
            <canvas class="medical-preview-canvas" data-preview-canvas aria-label="Selected PDF page" hidden></canvas>
            <div class="medical-preview-controls" data-preview-controls hidden>
              <button type="button" class="btn medical-secondary-button" data-preview-previous>Previous page</button>
              <span data-preview-page></span>
              <button type="button" class="btn medical-secondary-button" data-preview-next>Next page</button>
            </div>
          </div>
          <p class="medical-note" data-preview-message role="status">Choose a document to preview it locally.</p>
          <a class="btn medical-secondary-button" data-preview-open target="_blank" rel="noopener noreferrer" hidden>Open Selected Document</a>
        </fieldset>
        <fieldset class="medical-fieldset" data-medication-section <%= formData.categoryCode === 'medication_history' ? '' : 'hidden' %>>
          <legend>Structured medication details</legend>
          <p class="medical-note">Enter only details documented in the original; do not infer a prescription.</p>
          <div data-medication-entry-rows>
            <% const rows = reviewData.medications.length ? reviewData.medications : [{ medicationName: '', dosage: '', frequency: '', startDate: '', endDate: '' }]; %>
            <% rows.forEach((medication, index) => { %>
              <fieldset class="medication-entry-row" data-medication-entry-row>
                <legend class="visually-hidden">Medication entry</legend>
                <div class="row g-3">
                  <% [['medication_name', 'Medication name', medication.medicationName, 200], ['medication_dosage', 'Documented dosage', medication.dosage, 120], ['medication_frequency', 'Documented frequency', medication.frequency, 120]].forEach(field => { %>
                    <div class="col-12 col-md-4"><label class="form-label" for="<%= field[0] %>-<%= index %>"><%= field[1] %></label><input class="form-control" id="<%= field[0] %>-<%= index %>" name="<%= field[0] %>[]" maxlength="<%= field[3] %>" value="<%= field[2] %>"></div>
                  <% }); %>
                  <% [['medication_start_date', 'Start date', medication.startDate], ['medication_end_date', 'End date', medication.endDate]].forEach(field => { %>
                    <div class="col-12 col-md-6"><label class="form-label" for="<%= field[0] %>-<%= index %>"><%= field[1] %></label><input class="form-control" id="<%= field[0] %>-<%= index %>" name="<%= field[0] %>[]" type="date" value="<%= field[2] %>"></div>
                  <% }); %>
                  <div class="col-12"><button class="btn medical-cancel-button" type="button" data-remove-medication>Remove entry</button></div>
                </div>
              </fieldset>
            <% }); %>
          </div>
          <button class="btn medical-secondary-button" type="button" data-add-medication>Add medication entry</button>
          <template data-medication-entry-template>
            <fieldset class="medication-entry-row">
              <legend class="visually-hidden">Medication entry</legend>
              <div class="row g-3">
                <% [['medication_name', 'Medication name', 200], ['medication_dosage', 'Documented dosage', 120], ['medication_frequency', 'Documented frequency', 120]].forEach(field => { %>
                  <div class="col-12 col-md-4"><label class="form-label" for="<%= field[0] %>-new"><%= field[1] %></label><input class="form-control" id="<%= field[0] %>-new" name="<%= field[0] %>[]" maxlength="<%= field[2] %>"></div>
                <% }); %>
                <% [['medication_start_date', 'Start date'], ['medication_end_date', 'End date']].forEach(field => { %>
                  <div class="col-12 col-md-6"><label class="form-label" for="<%= field[0] %>-new"><%= field[1] %></label><input class="form-control" id="<%= field[0] %>-new" name="<%= field[0] %>[]" type="date"></div>
                <% }); %>
                <div class="col-12"><button class="btn medical-cancel-button" type="button" data-remove-medication>Remove entry</button></div>
              </div>
            </fieldset>
          </template>
        </fieldset>
        <fieldset class="medical-fieldset">
          <legend>Review and sign</legend>
          <div class="signature-panel"><canvas id="signaturePad" class="signature-canvas" width="900" height="260" aria-label="Draw your signature"></canvas></div>
          <div class="signature-toolbar"><button class="btn medical-secondary-button" type="button" data-signature-clear>Clear signature</button><span data-signature-status>Waiting for signature</span></div>
          <input id="signature-data-url" type="hidden" name="signature_data_url" value="">
          <div class="form-check mt-3"><input class="form-check-input" id="confirm-publish" name="confirm_publish" type="checkbox" value="yes" required><label class="form-check-label" for="confirm-publish">I reviewed the original document and all record details before publishing.</label></div>
        </fieldset>
        <button class="btn medical-primary-button" type="submit" name="action" value="publish" <%= pets.length ? '' : 'disabled' %>>Publish Medical Record</button>
      </form>
    </section>
  </main>
  <script src="/js/signature-pad.js" defer></script>
  <script src="/js/medical-medication-entries.js" defer></script>
  <script src="/js/admin-medical-upload.js" defer></script>
</body>
</html>
