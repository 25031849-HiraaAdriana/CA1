<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Dashboard | Pomi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="pomi-admin-content">
    <header class="pomi-admin-dashboard-header">
      <div>
        <p class="pomi-admin-dashboard-kicker">Pomi Admin Workspace</p>
        <h1>Welcome back, <%= session.user.name %></h1>
        <p>Choose an area to manage the Pomi platform.</p>
      </div>
    </header>

    <section class="pomi-admin-dashboard-links" aria-label="Admin management areas">
      <a class="pomi-admin-dashboard-card" href="/admin/users">
        <span class="pomi-admin-dashboard-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.8 20v-1.6a5.2 5.2 0 0 1 5.2-5.2h2a5.2 5.2 0 0 1 5.2 5.2V20M16 5.2a3.5 3.5 0 0 1 0 6.7M18 13.7a4.5 4.5 0 0 1 3.2 4.3v2"/></svg>
        </span>
        <strong>Users &amp; pets</strong>
        <small>View account details and associated pet profiles.</small>
      </a>

      <a class="pomi-admin-dashboard-card" href="/admin/medical-records">
        <span class="pomi-admin-dashboard-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M14 3v5h5M8.5 13h7M8.5 16.5h7M12 9.5v7"/></svg>
        </span>
        <strong>Medical records</strong>
        <small>Review, manage and publish pet medical records.</small>
      </a>

      <a class="pomi-admin-dashboard-card" href="/admin/refill-requests">
        <span class="pomi-admin-dashboard-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M10 3H7a4 4 0 0 0 0 8h10a4 4 0 0 1 0 8h-3M14 3h3a4 4 0 0 1 0 8H7a4 4 0 0 0 0 8h3M12 2v20"/></svg>
        </span>
        <strong>Medication refills</strong>
        <small>Review demonstration refill requests.</small>
      </a>

      <a class="pomi-admin-dashboard-card" href="/admin/appointments">
        <span class="pomi-admin-dashboard-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M8 14h3M8 17h6"/></svg>
        </span>
        <strong>Appointments</strong>
        <small>Manage the appointment tracker.</small>
      </a>

      <a class="pomi-admin-dashboard-card" href="/admin/products">
        <span class="pomi-admin-dashboard-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="m3 8 2-5h14l2 5M4 8v12h16V8M3 8h18M9 12v4h6v-4"/></svg>
        </span>
        <strong>Products</strong>
        <small>Manage Pet Shop product listings.</small>
      </a>

      <a class="pomi-admin-dashboard-card" href="/admin/activity-history">
        <span class="pomi-admin-dashboard-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 19V5M4 19h17M8 15l3-4 3 2 5-7"/><circle cx="8" cy="15" r="1"/><circle cx="11" cy="11" r="1"/><circle cx="14" cy="13" r="1"/><circle cx="19" cy="6" r="1"/></svg>
        </span>
        <strong>Activity history</strong>
        <small>Review recorded Admin activity.</small>
      </a>
    </section>
  </main>
</body>
</html>
