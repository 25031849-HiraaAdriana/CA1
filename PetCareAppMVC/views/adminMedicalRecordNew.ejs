<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Add Medical Record | Pomi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin-medical-records.css" rel="stylesheet">
</head>
<body class="medical-records-page">
  <%- include('partials/navbar') %>

  <main class="container medical-records-shell medical-form-shell">
    <a class="medical-back-link" href="/admin/medical-records">← Medical Records Management</a>
    <header class="medical-page-header">
      <p class="medical-eyebrow">Admin workspace · New Draft</p>
      <h1>Add a medical record</h1>
      <p>Upload an original document. Extracted text and the document will be kept private until a later review workflow is completed.</p>
    </header>

    <% if (errorMessage) { %>
      <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
    <% } %>

    <section class="medical-panel">
      <form method="post" action="/admin/medical-records" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <fieldset class="medical-fieldset">
          <legend>Existing registered pet</legend>
          <% if (selectedPet) { %>
            <input type="hidden" name="pet_id" value="<%= selectedPet.id %>">
            <div class="selected-pet-card">
              <span class="selected-pet-name"><%= selectedPet.name %></span>
              <span><%= selectedPet.species %> · <%= selectedPet.breed %></span>
              <span>Microchip ID: <%= selectedPet.microchip_id || 'Not on file' %></span>
              <span>AVS licence number: <%= selectedPet.avs_licence_number || 'Not on file' %></span>
            </div>
          <% } else { %>
            <div class="medical-empty-state" role="status">
              Select an existing pet from <a href="/admin/medical-records">Medical Records Management</a> before continuing.
            </div>
          <% } %>
        </fieldset>

        <fieldset class="medical-fieldset">
          <legend>Medical record information</legend>
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label class="form-label" for="category-code">Category <span aria-hidden="true">*</span></label>
              <select class="form-select" id="category-code" name="category_code" required>
                <option value="">Choose a category</option>
                <% categories.forEach(category => { %>
                  <option value="<%= category.category_code %>"
                    <%= formData.categoryCode === category.category_code ? 'selected' : '' %>>
                    <%= category.category_name %>
                  </option>
                <% }); %>
              </select>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label" for="record-date">Record or consultation date</label>
              <input class="form-control" id="record-date" name="record_date" type="date"
                value="<%= formData.recordDate %>">
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label" for="record-title">Record title <span aria-hidden="true">*</span></label>
              <input class="form-control" id="record-title" name="title" type="text" maxlength="200"
                value="<%= formData.title %>" required>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label" for="source-name">Veterinary clinic or source name <span aria-hidden="true">*</span></label>
              <input class="form-control" id="source-name" name="source_name" type="text" maxlength="200"
                value="<%= formData.sourceName %>" required>
            </div>
            <div class="col-12">
              <label class="form-label" for="record-description">Description <span class="optional-label">(optional)</span></label>
              <textarea class="form-control" id="record-description" name="description" rows="3"
                maxlength="60000"><%= formData.description %></textarea>
            </div>
          </div>
        </fieldset>

        <fieldset class="medical-fieldset">
          <legend>Original medical document</legend>
          <label class="form-label" for="medical-document">Upload PDF, JPEG or PNG <span aria-hidden="true">*</span></label>
          <input class="form-control" id="medical-document" name="medical_document" type="file"
            accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" required>
          <p class="medical-note">Maximum file size: <%= maxFileSizeMb %> MB. The document is validated by its file contents and stored privately outside the public web directory.</p>
        </fieldset>

        <div class="medical-form-notice" role="note">
          All uploaded records remain Draft. Text extraction does not make diagnoses, and no record is published automatically.
        </div>
        <div class="medical-form-actions">
          <a class="btn medical-cancel-button" href="/admin/medical-records">Cancel</a>
          <button class="btn medical-primary-button" type="submit" <%= selectedPet ? '' : 'disabled' %>>
            Upload and save Draft
          </button>
        </div>
      </form>
    </section>
  </main>
</body>
</html>
